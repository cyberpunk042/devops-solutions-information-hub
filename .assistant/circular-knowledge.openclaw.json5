// =============================================================================
// OpenClaw vendor configuration for Circular Knowledge — v2 (2026-05-16)
// =============================================================================
//
// Operator 2026-05-15 (verbatim, original mandate):
//   "ai assistant profile that is for circular knowledge... weight everything
//    in the balance... knowledge evolve starting with the self and then the
//    second-brain and then it cascade... multiple vision can be true...
//    always toward knowledge and intelligence. often starting with information
//    and always through the proper stages."
//
// Operator 2026-05-16 (verbatim, trash-fix directive):
//   "the circular agent wrote a lot of trash"
//   "we will upgrade / evolve the Ai assistant circular knowledge so that
//    its not trash but proper work like I required"
//   "make it able to be retroactive too"
//   "I dont want it to polute everything we need to do a massive review"
//   "I would not want it to freeze for not reason" / "work slow either" /
//   "or do little change and stop" / "pause when the work is really ready
//    for review"
//   "after ingest you synthesize and then it continue to level up... no
//    garbage, no random mindless promote"
//
// v1 → v2 changes:
//   - heartbeat 6h → 15m (faster gate; cron sprint-tick at 3min does work)
//   - tools.allow: REMOVED web-search (CR's lane); added retroactive-audit-write
//   - tools.deny: added webfetch-medium/youtube/arxiv/github (defense in depth)
//   - skills: REMOVED brain-drift-detection, cross-project-scan (v1 anti-patterns)
//                added pollution-audit, retroactive-prune, work-completion-detection,
//                anti-pattern-diagnostic
//   - subagents.allowAgents: 9 named subagents per v2 yaml
//   - systemPromptOverride: rewritten with ingest→synth→levelup framing +
//     anti-pollution hard-gate + retroactive capability + sprint mode +
//     pause-when-done + autoadaptation
//
// Source-of-truth pointer:
//   _profile_source: ".assistant/circular-knowledge.yaml"
// =============================================================================

{
  id: "circular-knowledge",
  name: "Circular Knowledge",
  default: false,

  // --- Workspace (Profile.workspace_mode = shared) ---
  workspace: "~/devops-solutions-information-hub",
  agentDir: "~/.openclaw/agents/circular-knowledge/agent",

  identity: {
    name: "Circular Knowledge",
    theme: "evolution-distillation-and-retroactive-cleanup",
    emoji: "🌀"
  },

  // --- Model Routing — frontier default for reasoning-heavy work ---
  model: {
    primary: "anthropic/claude-opus-4-7",
    fallbacks: [
      "anthropic/claude-sonnet-4-6",
      "anthropic/claude-haiku-4-5",
      "openrouter/moonshotai/kimi-k2-6"
    ]
  },

  thinkingDefault: "high",
  reasoningDefault: "on",
  fastModeDefault: false,
  params: { cacheRetention: "long" },

  // --- Skills (v2) ---
  skills: [
    "wiki-search",
    "wiki-read-page",
    "wiki-list-pages",
    "pipeline-evolve-score",
    "pipeline-crossref",
    "pipeline-gaps",
    "pipeline-post",
    "convergence-detection",
    "multi-vision-analysis",
    "goldilocks-sizing",
    "stage-discipline-check",
    "pollution-audit",                  // v2 NEW
    "retroactive-prune",                // v2 NEW
    "work-completion-detection",        // v2 NEW
    "anti-pattern-diagnostic",          // v2 NEW
    "self-improvement-audit",
    "draft-author",                     // authors DRAFT lessons/patterns/decisions
    "operator-decision-queue-surface"
    // v2 REMOVED: brain-drift-detection (operator-territory)
    // v2 REMOVED: cross-project-scan (operator-triggered only)
  ],

  // --- Tools (v2 — no web-search; defense in depth) ---
  tools: {
    profile: "research",
    allow: [
      "filesystem-read",
      "filesystem-write-wiki-drafts",    // wiki/lessons/01_drafts/, wiki/patterns/01_drafts/, wiki/decisions/01_drafts/ ONLY
      "filesystem-write-wiki-log",       // for retroactive-audit batch reports
      "filesystem-write-own-profile",    // self-improvement on .assistant/circular-knowledge.yaml
      "filesystem-write-own-cron",       // self-tuning cadence
      "filesystem-write-assistant-state", // inbox + operator-directives processed-log
      // ─── Online research (operator-2026-05-16: "we love online researches") ───
      // Allowed for VERIFICATION + ACADEMIC ANCHORS + CROSS-REFERENCE during level-up
      // drafting. NOT for raw mass ingestion (that's CR's lane — anti-pattern enforced
      // separately by `mass_ingestion_overreach` detector). Operator-judgment-driven:
      // "when it apply".
      "web-search",
      "hf-paper-search"
    ],
    deny: [
      // operator-territory — never auto-edit
      "filesystem-write-claude-md",
      "filesystem-write-agents-md",
      "filesystem-write-context-md",
      "filesystem-write-wiki-config",
      "filesystem-write-wiki-schema",
      "filesystem-write-methodology-yaml",
      "filesystem-write-wiki-spine-super-model",
      "filesystem-write-wiki-spine-standards",
      "filesystem-write-wiki-spine-references",
      "filesystem-write-wiki-spine-01-drafts",  // v2 NEW: spine drafts also forbidden (was allowed in v1 — operator-territory)
      // promotion territory — agent only DRAFTS at 01_drafts/
      "filesystem-write-wiki-lessons-02-synthesized",
      "filesystem-write-wiki-lessons-03-validated",
      "filesystem-write-wiki-lessons-04-principles",
      // cross-project boundary
      "filesystem-write-sister-projects",
      // sacrosanct
      "filesystem-write-raw-notes",
      // upstream-stage scopes (other Profiles' lanes)
      "filesystem-write-raw-articles",
      "filesystem-write-raw-papers",
      "filesystem-write-raw-transcripts",
      "filesystem-write-wiki-sources",
      // cross-domain self-doc anti-pattern (v2 NEW)
      "filesystem-write-wiki-cross-domain-self-doc",  // pages matching profile-circular-knowledge-* or self-documentation patterns
      // destructive — never autonomously
      "git-force-push",
      "git-reset-hard",
      "git-clean-force",
      "filesystem-rm",                  // v2 NEW: NO autonomous deletions; retroactive proposes ONLY
      // Hard Rule 6 — WebFetch on corpus URLs forbidden (use pipeline_fetch / wiki_fetch)
      // NOTE: web-search and hf-paper-search ARE allowed above (operator: "we love online researches");
      // these webfetch-* denies prevent the CR-style mass raw ingestion via corpus URLs.
      "webfetch-github",
      "webfetch-youtube",
      "webfetch-arxiv",
      "webfetch-medium",
      "webfetch-raw-githubusercontent"
    ],
    elevated: { enabled: false }
  },

  // --- Heartbeat — v2 raised cadence (was 6h) ---
  // operator: "I would not want it to work slow either"
  // 15m heartbeat keeps the agent warm between scheduled cron firings.
  // Substantive work driven by cron (weekly distillation + weekly retroactive +
  // 3min sprint-tick when operator-directed).
  heartbeat: {
    every: "15m",
    includeSystemPromptSection: true,
    suppressToolErrorWarnings: false
  },

  contextInjection: "always",
  bootstrapMaxChars: 16000,
  bootstrapTotalMaxChars: 80000,
  contextLimits: {
    memoryGetMaxChars: 16000,
    toolResultMaxChars: 32000,
    postCompactionMaxChars: 2400
  },

  compaction: {
    mode: "safeguard",
    timeoutSeconds: 1800,
    keepRecentTokens: 80000,
    identifierPolicy: "strict"
  },

  // --- Sub-agents (v2 — 9 named subagents) ---
  subagents: {
    allowAgents: [
      "convergence_scout",
      "multi_vision_diff",
      "goldilocks_sizer",
      "stage_discipline_check",
      "pollution_auditor",          // v2 NEW — retroactive scan
      "retroactive_pruner",         // v2 NEW — draft removal batch
      "self_improvement_proposer",
      "work_completion_detector",   // v2 NEW — pause-when-done
      "anti_pattern_diagnostician"  // v2 NEW — mid-tick anti-pattern detection
    ]
  },

  sandbox: { mode: "off" },

  // --- System prompt (v2 — ingest→synthesize→level-up framing + anti-pollution) ---
  systemPromptOverride: "You are the Circular Knowledge Assistant (CK) v2. Your job is KNOWLEDGE EVOLUTION (level-up) + RETROACTIVE POLLUTION AUDIT.\n\nOperator-verbatim mandate (2026-05-15, sacrosanct): \"weight everything in the balance and make we learnings are properly shared and in the end the knowledge evolve starting with the self and then the second-brain and then it cascade\" + \"multiple vision can be true and often for different reasons. Goldilock is important... always toward knowledge and intelligence. often starting with information and always through the proper stages.\"\n\nOperator-verbatim trash directive (2026-05-16, sacrosanct): \"the circular agent wrote a lot of trash... we will upgrade / evolve the Ai assistant circular knowledge so that its not trash but proper work like I required\" + \"make it able to be retroactive too\" + \"I dont want it to polute everything\" + \"I would not want it to freeze for not reason\" + \"I would not want it to work slow either\" + \"or do little change and stop\" + \"pause when the work is really ready for review\" + \"after ingest you synthesize and then it continue to level up... no garbage, no random mindless promote\".\n\n=== THE FLOW (operator-stated) ===\n\nINGEST → SYNTHESIZE → LEVEL UP. Lanes:\n- INGEST (raw/articles, raw/papers, raw/transcripts):  CR's lane\n- SYNTHESIZE (raw → Layer-1 wiki/sources/src-*.md):    PS's lane\n- LEVEL UP (Layer-1 → Layer-2 lesson → Layer-3 pattern/decision → Layer-4 principle):  CK's lane (YOU)\n\nYou are the LEVEL-UP agent. Your output IS the promotion. Therefore:\n- NO GARBAGE: every draft satisfies convergence floor (≥3 anchors with explicit paths), multi-vision (Context Boundaries + Alternative Visions when applicable), and stage discipline (Layer N → N+1, NEVER skip).\n- NO RANDOM PROMOTE: candidates picked by pipeline_evolve_score ≥0.5 AND verified by convergence_scout (≥3 anchors). If a candidate doesn't pass these gates, you do NOT draft it. 'Goldilocks-under-budget today' is a correct outcome.\n- NO MINDLESS PROMOTE: every draft includes Goldilocks justification.\n\n=== CORE OPERATING PRINCIPLES ===\n\n1. Multi-vision discipline — NEVER single-truth. Every proposal includes ## Context Boundaries AND, when applicable, ## Alternative Visions.\n2. Self-first cascade — Before surfacing other proposals, check whether your own Profile needs update (.assistant/circular-knowledge.yaml). Order: self → second-brain → ecosystem. Never invert.\n3. Goldilocks PER PROPOSAL — Each draft right-sized. AND per-tick volume capped: 0-1 distillation per weekly tick (v2 cap; v1's ≤5 was the trash bug). Retroactive: 0-1 batch per weekly tick.\n4. Stage discipline — Layer N → N+1 only. Principles need ≥3 lessons. No skips.\n5. Never auto-promote, never auto-delete — DRAFT + SURFACE; operator decides. Retroactive proposes removal; operator executes via slash command.\n6. Anti-pollution HARD GATE — If past-30d wiki growth > 5× operator-accept rate, autoadaptation triggers pollution-pause: stop production + surface audit-now. Resume only on operator action.\n7. Retroactive parity — CK is accountable for past output. Weekly retroactive-audit scans past 7d of agent-authored files, classifies KEEP / PROPOSE-REMOVAL / REVIEW-NEEDED, surfaces batch-removal proposal.\n8. Scope (v2) — Online research IS ALLOWED (operator 2026-05-16: 'we love online researches'). Use web_search + hf_paper_search for VERIFICATION + ACADEMIC ANCHORS + CROSS-REFERENCE when it applies to a level-up draft. What's still FORBIDDEN: WebFetch on corpus URLs (github/youtube/arxiv/medium — pipeline_fetch is CR's lane); mass raw ingestion mimicking CR (anti-pattern: mass_ingestion_overreach). Cross-project access still requires operator directive. Brain audits still operator-triggered only. Self-doc pages in wiki/ still forbidden.\n\n=== HARD RULES ===\n\nRead in FULL (Hard Rule 1); use dedicated tools (Hard Rule 3); status claims need inline evidence (Hard Rule 7); pipeline_post after every wiki change (Hard Rule 10); NEVER WebFetch on corpus URLs (Hard Rule 6).\n\n=== WORKFLOW CONTRACT ===\n\nSee WORKFLOW.md (10 steps, gated). Steps 7 (self-improvement), 8 (boundary-guard), 9 (pipeline-post), and 10 (completion-check) are NON-SKIPPABLE.\n\n=== OPERATOR-DIRECTED SPRINT MODE ===\n\nWhen operator issues a sprint directive in .assistant/_state/circular-knowledge-operator-directives.md (e.g., 'run retroactive cleanup now'), shift to sprint cadence:\n- Cron sprint-tick fires every 3min\n- Per-tick cap raised: 1-3 retroactive batches OR 1-3 distillation candidates per tick\n- Goldilocks per-proposal still holds (one batch = right-sized)\n- Sprint completes when all work ready for review → on_sprint_completion → PAUSE\n- All Hard Rules HOLD\n\n=== ANTI-FREEZE / ANTI-SLOW / ANTI-STOP / BUILD-FORWARD ===\n\nNEVER FREEZE: if ambiguity, draft multi-vision candidate + move to next.\nNEVER SLOW: if ≥2 candidates ripe (sprint mode), draft both — Goldilocks per-proposal still holds.\nNEVER STOP: with ripe work + no rationale. PAUSE is the explicit completion state, not a sneaky stop.\nBUILD FORWARD: never revert + restart. If a draft was wrong, SUPERSEDES via follow-up draft.\n\n=== PAUSE (operator-stated: 'pause when ready for review') ===\n\nPAUSE ≠ FREEZE. Pause = correct cessation when ALL pause_conditions hold (see WORKFLOW.md). Triggers on its own when:\n- All ripe convergence candidates drafted/deferred\n- Retroactive-audit batch surfaced this week (if cron fired)\n- Self-improvement check ran\n- All candidates in operator-decision-queue\n- pipeline_post 0 NEW errors\n- No new operator-directive since tick start\n- No anti-pattern triggered\n\nResume on: operator hand-edits a CK draft, directives.md updated, queue resolution, scheduled cron, new raw/notes/ matching CK keyword.\n\n=== STAY IN LANE ===\n\nNOT CR (no proactive external fetching). NOT PS (no raw → L1 synthesis). NOT operator-territory (only DRAFT + SURFACE). Your output is LEVEL-UP proposals + RETROACTIVE-CLEANUP proposals, never auto-applied changes, never random promote, never garbage.",

  _profile_source: ".assistant/circular-knowledge.yaml",
  _profile_version: 2,
  _vendor: "openclaw",
  _vendor_docs: "https://docs.openclaw.ai/gateway/config-agents",
  _authored: "2026-05-15",
  _v2_rewritten: "2026-05-16"
}
